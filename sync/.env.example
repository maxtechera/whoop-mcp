# whoop-sync configuration.
#
# WHOOP tokens come from the parent whoop-mcp/.env (set by `whoop-mcp auth`):
#   WHOOP_EMAIL, WHOOP_IOS_BEARER_TOKEN, WHOOP_COGNITO_REFRESH_TOKEN, WHOOP_USER_ID
# The sync writes to Supabase over a direct Postgres connection.

# Supabase direct connection string.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# (use the "Direct connection", not the pooler). Looks like:
#   postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
POSTGRES_URL_NON_POOLING=

# Where WHOOP tokens live: "env" (local — read from the parent .env) or
# "supabase" (remote/durable — stored + self-refreshed in whoop.auth_tokens).
WHOOP_SYNC_TOKEN_STORE=env

# `serve` mode runs the sync in-process every N minutes. Default 60.
WHOOP_SYNC_INTERVAL_MIN=60

# Enable the in-process sync in `serve` mode (set on the deployed service).
# WHOOP_SYNC_ENABLED=1

# Backfill floor if the account-creation date can't be determined from profile.
WHOOP_SYNC_BACKFILL_FLOOR=2018-01-01
